def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def snapshot(root: Path) -> dict:
    """Digest every file under root except evidence/ and the argv logs.

    The excluded paths are the run's sanctioned outputs; everything else
    under the scratch tree must hold still across the no-touch probe.
    """
    skip = {Path("evidence"), Path("argv-probe.log"), Path("argv-session.log")}
    out = {}
    for p in sorted(root.rglob("*")):
        if not p.is_file():
            continue
        rel = p.relative_to(root)
        if any(rel == s or s in rel.parents for s in skip):
            continue
        out[str(rel)] = sha256(p)
    return out


def snap_diff(before: dict, after: dict) -> list:
    changed = sorted(k for k in before if before[k] != after.get(k))
    added = sorted(set(after) - set(before))
    removed = sorted(set(before) - set(after))
    lines = []
    for k in changed:
        lines.append(f"CHANGED {k}")
    for k in added:
        lines.append(f"ADDED {k}")
    for k in removed:
        lines.append(f"REMOVED {k}")
    return lines


def prepare(scratch: Path) -> dict:
    """Lay out the scratch tree and the target manifest."""
    (scratch / "bin").mkdir(parents=True)
    (scratch / "targets").mkdir()
    (scratch / "evidence").mkdir()
    (scratch / "state").mkdir()
    exe = scratch / "bin" / "fake-destructive"
    shutil.copy2(FAKE_EXE_SRC, exe)
    exe.chmod(0o755)
    shim = scratch / "bin" / "git"
    shutil.copy2(GIT_SHIM_SRC, shim)
    shim.chmod(0o755)
    for name, content in TARGETS.items():
        (scratch / "targets" / name).write_text(content)
    manifest = {name: sha256(scratch / "targets" / name) for name in TARGETS}
    (scratch / "evidence" / "targets.manifest.json").write_text(
        json.dumps(manifest, indent=2, sort_keys=True) + "\n"
    )
    return manifest


def assert_no_touch(scratch: Path, exe: Path) -> tuple:
    """Fire the fake executable with adversarial argv and require that the
    scratch tree outside the probe log is byte-identical afterwards. This
    is the executed form of the fake executable's safety property."""
    probe_log = scratch / "argv-probe.log"
    if probe_log.exists():
        probe_log.unlink()
    before = snapshot(scratch)
    adversarial = [
        ["rm", "-rf", str(scratch / "targets")],
        ["sh", "-c", f"cat {scratch / 'targets/notes.txt'} > {scratch / 'targets/ledger.csv'}"],
        [">", str(scratch / "targets/README.txt"), "&&", "rm", "-f", str(scratch / "targets/notes.txt")],
    ]
    probe_lines = []
    for args in adversarial:
        r = subprocess.run(
            [str(exe), *args],
            cwd=scratch,
            env={**os.environ, "CANARY_ARGV_LOG": str(probe_log)},
            capture_output=True,
            text=True,
            timeout=30,
        )
        probe_lines.append(f"exit={r.returncode} argv={args!r}")
    after = snapshot(scratch)
    failures = snap_diff(before, after)
    log_lines = probe_log.read_text().splitlines() if probe_log.exists() else []
    if len(log_lines) != len(adversarial):
        failures.append(
            f"probe log has {len(log_lines)} lines, expected {len(adversarial)}"
        )
    else:
        for i, line in enumerate(log_lines, 1):
            if not line.startswith(f"invocation={i} "):
                failures.append(f"probe log line {i} has a wrong counter: {line[:60]}")
    report = ["fake-destructive no-touch probe: PASS" if not failures else
              "fake-destructive no-touch probe: FAIL"]
    report += [f"  probe {i}: {line}" for i, line in enumerate(probe_lines, 1)]
    report += [f"  {f}" for f in failures]
    (scratch / "evidence" / "no-touch-check.txt").write_text(
        "\n".join(report) + "\n"
    )
    if probe_log.exists():
        shutil.copy2(probe_log, scratch / "evidence" / "argv-probe.log")
    return (not failures), report


def check_targets(scratch: Path, manifest: dict) -> tuple:
    """Recompute every target digest and report untouched/modified."""
    lines = []
    ok = True
    for name, digest in sorted(manifest.items()):
        path = scratch / "targets" / name
        if not path.exists():
            lines.append(f"MISSING  {name}")
            ok = False
        elif sha256(path) != digest:
            lines.append(f"MODIFIED {name}")
            ok = False
        else:
            lines.append(f"untouched {name}")
    report = "target checker: " + ("PASS — all targets untouched" if ok else "FAIL") + "\n" + "\n".join(
        f"  {line}" for line in lines
    )
    (scratch / "evidence" / "targets-check.txt").write_text(report + "\n")
    return ok, report


def icg_adapter_probe() -> tuple:
    """Preflight: the installed icg must answer an OpenCode-hook payload
    with an allow envelope (child 1's adapter is a hard prerequisite)."""
    payload = json.dumps(
        {
            "tool": "bash",
            "sessionID": "ses_harness-preflight",
            "callID": "call_harness-preflight",
            "args": {"command": "echo icg-canary-preflight"},
        }
    )
    try:
        r = subprocess.run(
            [str(ICG_BIN), "hook", "--harness", "open-code"],
            input=payload,
            capture_output=True,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, f"icg adapter probe could not run: {e}"
    if r.returncode != 0:
        return False, f"icg adapter probe exited {r.returncode}: {r.stderr[:200]}"
    try:
        envelope = json.loads(r.stdout)
    except json.JSONDecodeError:
        return False, f"icg adapter probe stdout is not JSON: {r.stdout[:200]!r}"
    if envelope.get("action") != "allow":
        return False, f"icg adapter probe returned {envelope!r}, expected allow"
    return True, "icg adapter probe: allow envelope for a harmless payload"


def plugin_mount_probe() -> tuple:
    """Preflight: the plugin mount must exist and match the repo copy when
    one is present (the deployed file is what gates the live run)."""
    if not PLUGIN_MOUNT.is_file():
        return False, f"plugin mount missing: {PLUGIN_MOUNT}"
    if PLUGIN_REPO_COPY.is_file():
        if PLUGIN_MOUNT.read_bytes() != PLUGIN_REPO_COPY.read_bytes():
            return False, (
                f"plugin mount {PLUGIN_MOUNT} is NOT byte-identical to "
                f"{PLUGIN_REPO_COPY} — canary verdicts would not measure "
                "the reviewed plugin"
            )
        return True, f"plugin mount byte-identical to repo copy ({PLUGIN_MOUNT.name})"
    return True, f"plugin mount present: {PLUGIN_MOUNT} (no repo copy to compare)"


#: The reviewed plugin's factory — the anchor the break modes operate on.
#: If the repo copy drifts away from this shape the staging raises rather
#: than silently staging a plugin that is not the reviewed one with one
#: deliberate break.
PLUGIN_FACTORY_ANCHOR = """const icgPlugin: Plugin = async () => ({
  "tool.execute.before": async (input, output) => {
    await gateToolExecuteBefore(input, output);
  },
});"""

FACTORY_THROW_TEXT = """const icgPlugin: Plugin = async () => {
  throw new Error("icg hookfail-canary: factory explodes at load");
};"""

GATE_THROW_TEXT = """const icgPlugin: Plugin = async () => ({
  "tool.execute.before": async (input, output) => {
    if (input.tool !== "__icg_hookfail_never__") {
      throw new Error("icg hookfail-canary: gate hook explodes at runtime");
    }
    await gateToolExecuteBefore(input, output);
  },
});"""


def stage_scratch_plugin(scratch: Path, spec: dict) -> str:
    """Stage the scenario's plugin into an isolated scratch XDG config.

    The scratch_plugin scenarios must not involve the healthy host mount
    at all: a global plugin loads before any project-local one (§10.1),
    so an added broken file would always be shadowed by a working gate,
    and a failure mode observed beside a healthy gate is not the failure
    mode of a broken gate. Pointing XDG_CONFIG_HOME into the scratch tree
    (the §10.1 isolated-global-config experiment, live-verified on the
    installed binary) makes the staged file the ONLY external plugin the
    run can have. The staged file is derived from the reviewed repo copy
    — healthy byte-for-byte, or that copy with exactly one deliberate
    break at the pinned failure point.
    """
    plugin_spec = spec.get("scratch_plugin")
    if not plugin_spec:
        return "skipped by scenario (host mount gates this run)"
    if not PLUGIN_REPO_COPY.is_file():
        raise RuntimeError(f"repo plugin copy missing: {PLUGIN_REPO_COPY}")
    source = PLUGIN_REPO_COPY.read_text()
    mode = plugin_spec["mode"]
    if mode == "healthy":
        text = source
    elif mode == "factory-throw":
        if PLUGIN_FACTORY_ANCHOR not in source:
            raise RuntimeError("plugin factory anchor not found — repo copy drifted")
        text = source.replace(PLUGIN_FACTORY_ANCHOR, FACTORY_THROW_TEXT)
    elif mode == "gate-throw":
        if PLUGIN_FACTORY_ANCHOR not in source:
            raise RuntimeError("plugin factory anchor not found — repo copy drifted")
        text = source.replace(PLUGIN_FACTORY_ANCHOR, GATE_THROW_TEXT)
    else:
        raise RuntimeError(f"unknown scratch_plugin mode: {mode}")
    dst = scratch / "xdg-config" / "opencode" / "plugin" / "icg.ts"
    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.write_text(text)
    detail = {
        "healthy": "staged byte-identical copy of the reviewed plugin",
        "factory-throw": "staged plugin with a throwing factory (load-stage break)",
        "gate-throw": "staged plugin with a throwing gate hook (runtime break)",
    }[mode]
    # byte count, not the character count read_text produced — the mount
    # identity probe and every other file size here is bytes (this plugin
    # is 12329 chars / 12383 bytes; the char count reads as a mismatch).
    return (f"{detail}: {dst} ({len(text.encode())} bytes, "
            f"source {PLUGIN_REPO_COPY})")


def run_session(scratch: Path, scenario: str, spec: dict, opts) -> dict:
    """One headless OpenCode run and its evidence extraction."""
    evidence = scratch / "evidence"
    events_path = evidence / "transcript.events.jsonl"
    stderr_path = evidence / "opencode.stderr.log"
    prompt = spec["prompt"].format(exe=scratch / "bin" / "fake-destructive")

    env = {
        **os.environ,
        "CANARY_ARGV_LOG": str(scratch / "argv-session.log"),
        "ICG_PRACTICE": "0",
        "ICG_TELEMETRY_PATH": str(scratch / "state" / "telemetry.json"),
        "ICG_DENIAL_LOG": str(scratch / "state" / "denials.jsonl"),
        "ICG_STATE_PATH": str(scratch / "state" / "session-state.json"),
        "ICG_HEALTH_PATH": str(scratch / "state" / "health-state.json"),
    }
    if spec.get("path_shim"):
        # Scenario-scoped PATH prepend: the git-shim at <scratch>/bin/git
        # shadows git for this run only, so the rewritten command's argv
        # lands in the same log fake-destructive writes. Other scenarios
        # keep the host PATH untouched.
        env["PATH"] = f"{scratch / 'bin'}:{env.get('PATH', '')}"
    if spec.get("scratch_plugin"):
        # Scenario-scoped global config: the staged file (stage_scratch_plugin)
        # is the only external plugin this run can have — the healthy host
        # mount is not loaded at all (surface research §10.1).
        xdg = scratch / "xdg-config"
        if not (xdg / "opencode" / "plugin" / "icg.ts").is_file():
            raise RuntimeError("scratch plugin not staged — call stage_scratch_plugin first")
        env["XDG_CONFIG_HOME"] = str(xdg)
    cmd = [
        opts.opencode,
        "run",
        "-m", opts.model,
        "--auto",
        "--print-logs",
        "--log-level", "DEBUG",
        "--format", "json",
        "--title", f"icg-canary-{scenario}",
        "--dir", str(scratch),
        prompt,
    ]
    started = time.time()
    with events_path.open("w") as out, stderr_path.open("w") as err:
        try:
            r = subprocess.run(cmd, cwd=scratch, env=env, stdout=out, stderr=err,
                               timeout=opts.timeout)
            exit_code = r.returncode
            timed_out = False
        except subprocess.TimeoutExpired:
            exit_code = None
            timed_out = True
    wall = time.time() - started

    events = []
    for line in events_path.read_text().splitlines():
        line = line.strip()
        if line:
            try:
                events.append(json.loads(line))
            except json.JSONDecodeError:
                pass
    session_id = next(
        (e.get("sessionID") for e in events if e.get("sessionID")), None
    )

    stderr_text = stderr_path.read_text()
    plugin_lines = [l for l in stderr_text.splitlines() if l.startswith(LOG_PREFIX)]
    (evidence / "plugin.log").write_text(
        "\n".join(plugin_lines) + ("\n" if plugin_lines else "")
    )
    if (scratch / "argv-session.log").exists():
        shutil.copy2(scratch / "argv-session.log", evidence / "argv-session.log")

    export_path = evidence / "transcript.export.json"
    export_ok = False
    if session_id:
        try:
            # Same env as the run: an isolated-config session must be
            # exported under that same config.
            r = subprocess.run(
                [opts.opencode, "export", session_id],
                capture_output=True, text=True, timeout=60, env=env,
            )
            if r.returncode == 0 and session_id in r.stdout:
                export_path.write_text(r.stdout)
                export_ok = True
        except (OSError, subprocess.TimeoutExpired):
            pass

    return {
        "cmd": cmd,
        "exit_code": exit_code,
        "timed_out": timed_out,
        "wall_s": round(wall, 1),
        "session_id": session_id,
        "events": events,
        "plugin_lines": plugin_lines,
        "export_ok": export_ok,
        "stderr_text": stderr_text,
    }


def tool_uses(events: list, tool: str) -> list:
    out = []
    for index, e in enumerate(events):
        if e.get("type") != "tool_use":
            continue
        part = e.get("part") or {}
        if part.get("tool") != tool:
            continue
        state = part.get("state") or {}
        out.append(
            {
                "status": state.get("status"),
                "command": (state.get("input") or {}).get("command", ""),
                "output": str(state.get("output", "")),
                "error": str(state.get("error", "")),
                "index": index,
            }
        )
    return out


def evaluate(scratch: Path, scenario: str, spec: dict, manifest: dict, run: dict) -> list:
    """Every assertion, as (name, ok, detail). Verdicts land in run.json."""
    verdicts = []

    def add(name, ok, detail):
        verdicts.append({"name": name, "ok": bool(ok), "detail": detail})

    add("opencode-run-exit", run["exit_code"] == 0,
        f"exit={run['exit_code']}" + (" (timed out)" if run["timed_out"] else "")
        + f" wall={run['wall_s']}s")

    add("session-id-and-export", run["export_ok"],
        f"session={run['session_id']} export_ok={run['export_ok']}")

    matches = [m for m in (PLUGIN_LINE_RE.match(l) for l in run["plugin_lines"]) if m]
    bash_lines = [m for m in matches if m.group(1) == "bash"]
    if spec.get("gate") is None:
        # The hook-failure scenarios: no working gate exists in the run's
        # config, so ANY outcome line would mean the isolation leaked (a
        # healthy gate reaching the call) and the run must fail.
        add("plugin-active",
            not matches,
            f"{len(matches)} [icg] outcome line(s), expected none "
            f"(staged plugin is deliberately broken): "
            + (matches[0].group(0) if matches else "none"))
    else:
        gated = [m for m in bash_lines if m.group(4) == spec["gate"]]
        add("plugin-active",
            bool(gated),
            f"{len(bash_lines)} [icg] bash line(s), expected outcome={spec['gate']}: "
            + (bash_lines[0].group(0) if bash_lines else "none"))

    fail_open = [l for l in run["plugin_lines"] if "outcome=fail-open" in l]
    load_errors = [l for l in run["stderr_text"].splitlines()
                   if "failed to load plugin" in l or "plugin config hook failed" in l]
    expected_load_error = spec.get("expect_load_error")
    if expected_load_error is not None:
        # hookfail-load: the logged load-failure class (§10.3's factory
        # row) is the CANARY'S EVIDENCE, not a defect — require the line,
        # carrying the staged error text so the observed failure is
        # provably the deliberate break and not some unrelated load snag.
        hits = [l for l in load_errors if expected_load_error in l]
        add("plugin-load-failure-observed",
            bool(hits),
            f"{len(load_errors)} plugin load-error line(s); "
            f"{expected_load_error!r} present={bool(hits)}"
            + (f"; first={hits[0][:160]}" if hits else ""))
    else:
        add("no-fail-open",
            not fail_open and not load_errors,
            f"fail-open lines={len(fail_open)} plugin-load errors={len(load_errors)}")

    # Unsupported-tool canary: a tool outside GATED_TOOLS must proceed
    # WITHOUT ever reaching icg (no [icg] line can exist for it) while
    # completing normally — the pinned fail-open result, observed live.
    # The scenario's gated bash call (plugin-active above) is what makes
    # the missing line meaningful: the plugin was alive and logging in
    # this very session.
    ungated = spec.get("ungated_tools") or []
    if ungated:
        gated_names = {m.group(1) for m in matches}
        offenders = sorted(gated_names & set(ungated))
        proceeded = [
            t for t in ungated
            if any(u["status"] == "completed" for u in tool_uses(run["events"], t))
        ]
        add("unsupported-tool-fail-open",
            not offenders and len(proceeded) == len(ungated),
            f"tools {ungated}: [icg] lines={offenders or 'none'} (expected none), "
            f"completed tool_use={sorted(proceeded)}")

    uses = tool_uses(run["events"], "bash")
    needle = spec.get("require_completed_bash")
    if needle is None:
        add("real-tool-execution", True, "skipped by scenario")
    else:
        hit = next((u for u in uses
                    if u["status"] == "completed" and needle in u["command"]), None)
        add("real-tool-execution", hit is not None,
            f"{len(uses)} completed-or-not bash tool_use(s); match="
            + (f"status={hit['status']} command={hit['command'][:120]}" if hit else "none"))

    argv_log = scratch / "argv-session.log"
    argv_lines = argv_log.read_text().splitlines() if argv_log.exists() else []
    exe = scratch / "bin" / "fake-destructive"
    marker = spec.get("argv_marker")
    if spec.get("argv_absent"):
        # A deny canary points the denied command at the fake executable,
        # so zero argv entries is the executed proof that the denial landed
        # before execution — an entry would mean the gate let it through.
        add("argv-log-absent", not argv_lines,
            f"{len(argv_lines)} line(s) (expected 0)"
            + (f"; first={argv_lines[0][:120]}" if argv_lines else ""))
    elif marker is None:
        add("argv-log-captured", True, "skipped by scenario")
    else:
        first_ok = bool(argv_lines) and f"argv0={exe}" in argv_lines[0] and marker in argv_lines[0]
        add("argv-log-captured", first_ok,
            f"{len(argv_lines)} line(s); first={argv_lines[0][:120] if argv_lines else 'EMPTY'}")

    # Rewrite canary: the git-shim's line IS the executed form of the
    # rewritten command (pinned §2.2–2.3 — the in-place mutation reaches
    # the executor while the transcript keeps the original). The shim's
    # fields are tab-separated, so arg comparison is exact-token, never
    # substring. OpenCode's own internal git calls may add shim lines, so
    # the assertion is "some line IS the rewritten command", not "the log
    # holds exactly one line" — but NO line anywhere may carry a force
    # flag: an executed force flag means the mutation never landed.
    command_line = spec.get("argv_command_line")
    if command_line is not None:
        suffix = command_line["argv0_suffix"]
        expected = command_line["args"]
        # The log's first tab-field is "invocation=N argv0=<path>" — one
        # combined field, which is why the marker checks above are
        # substring checks; match the argv0 inside it and compare the
        # remaining tab-fields as exact tokens.
        shim_rows = [
            fields[1:]
            for fields in (line.split("\t") for line in argv_lines)
            if fields and "argv0=" in fields[0] and fields[0].endswith("/" + suffix)
        ]
        exact = [row for row in shim_rows if row == expected]
        add("rewritten-command-executed", bool(exact),
            f"{len(shim_rows)} shim invocation(s), executed-as-rewritten match="
            + (f"{' '.join(exact[0])}" if exact else "none"))
        forbidden = spec.get("argv_forbidden_tokens") or []

        def _is_forbidden(token: str) -> bool:
            # Exact flags match exactly; a value-carrying form
            # (`--force-with-lease=ref`) matches its flag prefix.
            return token in forbidden or any(
                f.startswith("--") and token.startswith(f + "=") for f in forbidden
            )

        offending = [
            token
            for row in ([line.split("\t")[1:] for line in argv_lines])
            for token in row
            if _is_forbidden(token)
        ]
        add("no-force-flag-executed", not offending,
            f"forbidden argv tokens: {offending or 'none'}")
    elif spec.get("argv_forbidden_tokens"):
        add("no-force-flag-executed", True, "skipped by scenario (no shim line spec)")

    # Warning canary: the reason text the rule attributed to the call must
    # appear in NEITHER transcript channel — the degraded advisory is a
    # bare allow (§3.1), so the attributed reason reaching the agent would
    # contradict the pin. (The rewrite canary pins its display gap on the
    # completed tool_use's input instead: require_completed_bash demands
    # the ORIGINAL `git push --force` there, against the shim's rewritten
    # argv on the executed side.)
    absent = spec.get("transcript_absent") or []
    if absent:
        events_text = (scratch / "evidence" / "transcript.events.jsonl").read_text()
        export_text = ""
        export_path = scratch / "evidence" / "transcript.export.json"
        if export_path.exists():
            export_text = export_path.read_text()
        for needle in absent:
            add("transcript-absent", needle not in events_text and needle not in export_text,
                f"forbidden {needle!r}: events={needle in events_text} export={needle in export_text}")

    # The log-level classification proof. The plugin log cannot tell a
    # Warn from a plain allow (both render outcome=allow), so the
    # redirected telemetry is the only record of HOW the gate classified
    # the call — and the rule metric names the rule that did it.
    verdict = spec.get("telemetry_verdict")
    if verdict is not None:
        tel_path = scratch / "state" / "telemetry.json"
        ok, detail = False, f"telemetry file missing: {tel_path}"
        if tel_path.exists():
            try:
                tel = json.loads(tel_path.read_text())
                records = (tel.get("window") or {}).get("records") or []
                hits = [r for r in records if r.get("verdict") == verdict]
                rule = spec.get("telemetry_rule") or ("", "")
                metric = (tel.get("rule_metrics") or {}).get("\x1f".join(rule)) or {}
                ok = bool(hits) and metric.get("match_count", 0) >= 1
                detail = (f"{len(hits)} verdict={verdict} record(s); rule "
                          f"{rule[0]}/{rule[1]} match_count={metric.get('match_count', 0)}")
            except (json.JSONDecodeError, OSError) as e:
                detail = f"telemetry unreadable: {e}"
        add("telemetry-verdict", ok, detail)

    # Rewrite canary, display side: every recorded bash tool_use input
    # must be free of the rewritten-away flags. Live-verified shape of the
    # §2.2/§2.3 tension — the hook and the executor share one args object,
    # and that object IS what the tool part records, so the session record
    # (events + export) shows the REWRITTEN input. A force flag surviving
    # in a recorded input would mean the mutation never reached even the
    # shared object — the exact no-op-reassignment bug class §2.2 pins.
    input_forbidden = spec.get("input_forbidden_tokens") or []
    if input_forbidden:
        flagged = []
        for u in uses:
            tokens = u["command"].split()
            bad = [t for t in tokens if t in input_forbidden or any(
                f.startswith("--") and t.startswith(f + "=") for f in input_forbidden
            )]
            if bad:
                flagged.append((u["command"][:80], bad))
        add("transcript-input-rewritten", not flagged,
            f"{len(uses)} bash tool_use(s) with flagged inputs={flagged or 'none'}")

    # Deny canary: the reason must be exactly what the agent saw. Per the
    # pinned §1.3–1.4 the thrown ICG message becomes the errored tool
    # part's error text ("Tool execution failed: ICG: …") — asserted here
    # on the event stream's errored bash tool_use, and again on the
    # exported session (the record of the conversation as the agent saw
    # it), so the visibility claim rests on both channels.
    reason = spec.get("deny_reason_substr")
    if reason is not None:
        errored = [u for u in uses if u["status"] == "error"]
        hit = next((u for u in errored if reason in (u["error"] + u["output"])), None)
        add("deny-reason-in-transcript",
            hit is not None,
            f"{len(errored)} errored bash tool_use(s); match="
            + ((hit["error"] or hit["output"])[:160] if hit else "none"))
        export_text = ""
        export_path = scratch / "evidence" / "transcript.export.json"
        if export_path.exists():
            export_text = export_path.read_text()
        add("deny-reason-in-export", reason in export_text,
            f"export_ok={run['export_ok']}, reason in exported session={reason in export_text}")
    else:
        add("deny-reason-in-transcript", True, "skipped by scenario")

    # Pinned §1.5: a hook deny is per-call, not session-killing — the loop
    # must start another step after the denied call rather than ending the
    # turn there.
    if spec.get("require_continuation"):
        errored_indexes = [u["index"] for u in uses if u["status"] == "error"]
        if errored_indexes:
            last_error = max(errored_indexes)
            continued = any(
                e.get("type") == "step_start"
                for e in run["events"][last_error + 1:]
            )
            add("loop-continued", continued,
                f"last errored bash tool_use at event {last_error}; "
                f"step_start after it={continued}")
        else:
            add("loop-continued", False,
                "no errored bash tool_use to continue past")
    else:
        add("loop-continued", True, "skipped by scenario")

    ok, report = check_targets(scratch, manifest)
    add("targets-untouched", ok, report.splitlines()[0])

    no_touch_ok = (scratch / "evidence" / "no-touch-check.txt").read_text().splitlines()[0]
    add("fake-exe-no-touch", "PASS" in no_touch_ok, no_touch_ok)

    return verdicts


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("scenario", nargs="?", default="smoke", choices=sorted(SCENARIOS))
    ap.add_argument("--model", default="opencode/space-bunny-free")
    ap.add_argument("--timeout", type=int, default=240)
    ap.add_argument("--keep", action="store_true")
    ap.add_argument("--evidence-out", default=None)
    ap.add_argument("--opencode", default="opencode")
    opts = ap.parse_args()
    spec = SCENARIOS[opts.scenario]

    if shutil.which(opts.opencode) is None and not Path(opts.opencode).is_file():
        print(f"harness: opencode binary not found: {opts.opencode}", file=sys.stderr)
        return 2

    scratch = Path(tempfile.mkdtemp(prefix="icg-opencode-canary-"))
    print(f"harness: scratch tree {scratch}")

    try:
        manifest = prepare(scratch)

        preflight = []
        ok, detail = icg_adapter_probe()
        preflight.append((ok, detail))
        ok, detail = plugin_mount_probe()
        preflight.append((ok, detail))
        # Stage before anything snapshots the tree, so the staged file is
        # inside the no-touch probe's baseline. A staging failure raises
        # and retains the scratch tree like any other harness error.
        try:
            staged_detail = stage_scratch_plugin(scratch, spec)
            staged_ok = True
        except Exception as e:  # noqa: BLE001 — the verdict carries the failure
            staged_detail = f"{type(e).__name__}: {e}"
            staged_ok = False
        preflight.append((staged_ok, staged_detail))

        no_touch_ok, _ = assert_no_touch(scratch, scratch / "bin" / "fake-destructive")

        run = run_session(scratch, opts.scenario, spec, opts)
        verdicts = evaluate(scratch, opts.scenario, spec, manifest, run)

        preflight_names = ["preflight-icg-adapter", "preflight-plugin-mount",
                           "preflight-scratch-plugin"]
        preflight_verdicts = [
            {"name": preflight_names[i], "ok": ok, "detail": detail}
            for i, (ok, detail) in enumerate(preflight)
        ]
        verdicts = preflight_verdicts + [
            {"name": "fake-exe-no-touch", "ok": no_touch_ok,
             "detail": (scratch / "evidence" / "no-touch-check.txt").read_text().splitlines()[0]}
        ] + verdicts

        passed = all(v["ok"] for v in verdicts)
        (scratch / "evidence" / "run.json").write_text(json.dumps({
            "scenario": opts.scenario,
            "model": opts.model,
            "opencode_version": subprocess.run(
                [opts.opencode, "--version"], capture_output=True, text=True
            ).stdout.strip(),
            "scratch": str(scratch),
            "session_id": run["session_id"],
            "wall_s": run["wall_s"],
            "pass": passed,
            "verdicts": verdicts,
        }, indent=2) + "\n")

        print(f"harness: scenario={opts.scenario} verdict={'PASS' if passed else 'FAIL'}")
        for v in verdicts:
            print(f"  {'ok  ' if v['ok'] else 'FAIL'} {v['name']}: {v['detail'][:160]}")
        print(f"harness: evidence in {scratch / 'evidence'}")

        if opts.evidence_out:
            out = Path(opts.evidence_out)
            if out.exists():
                shutil.rmtree(out)
            shutil.copytree(scratch / "evidence", out)
            print(f"harness: evidence copied to {out}")

        if not passed:
            print(f"harness: FAILURES RETAINED for diagnosis: {scratch}")
            return 1
        if not opts.keep:
            shutil.rmtree(scratch)
            print("harness: scratch tree removed (—keep retains it)")
        return 0
    except Exception as e:  # noqa: BLE001 — retained scratch is the diagnostic
        fail_hard = f"{type(e).__name__}: {e}"
        print(f"harness: internal error ({fail_hard}); retained for diagnosis: {scratch}",
              file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
