#!/usr/bin/env python3
"""Warm-cache latency benchmark for `icg check`.

Times whole `icg check` invocations — process spawn to exit, which is the
cost a harness hook pays per tool call — after warming the OS page cache so
binary and pack reads come from memory, not disk. The headline number this
script exists to reproduce is README's warm-cache median claim; the measured
record and its environment live in docs/notes/check-latency-benchmark.md.

Method (also printed with every run, so an output is never separated from
its meaning):

  * One sample = one fresh `icg check` process, wall-clocked around the
    whole child with time.perf_counter_ns. A check is a short-lived
    process; there is no in-process warm state to amortize, so "warm cache"
    means page cache only.
  * `--warmup` untimed runs per case first, so the timed samples do not pay
    first-touch disk reads (the box's page cache, not a stash inside icg —
    the engine holds no cache between processes).
  * `--iterations` timed samples per case, summarized as min / p50 / mean /
    p90 / p99 / max / stdev. The claim being checked is a median, so the
    p50 is the number to compare; the tail is reported because a hook runs
    on every tool call, not an average one.
  * Default cases: an allow (`git status`) and a deny (`bao kv destroy
    secret/app/db`). Neither touches the network. Each run's stdout is
    checked against its expected verdict, so a binary that silently
    mis-evaluates is never benchmarked as if it were healthy.
  * ICG_DENIAL_LOG is pointed at a temporary file for every run: deny-case
    samples exercise the operational denial append (as production does)
    without ever appending benchmark noise to the operator's real log.

Environment (host, CPU, memory, load, kernel, binary version, and the
pack set the binary itself reports loading) is captured into every report —
a latency number without its environment is not reproducible.

Examples:

    scripts/bench-check-latency
    scripts/bench-check-latency --json
    scripts/bench-check-latency --iterations 200 --cases allow
    scripts/bench-check-latency --assert-under 50      # regression gate: exit 1 if p50 >= 50 ms

The binary defaults to a release build from the workspace's cargo target
directory and falls back to `icg` on PATH, loudly — benchmarking a dev
profile binary against the release claim would measure the wrong thing.
"""

import argparse
import json
import os
import platform
import statistics
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent

# The two default cases. Both are non-push, so neither can reach the
# git-stale-remote-head-push network lookup documented as the no-network
# rule's exception; the deny case additionally exercises the operational
# denial append.
CASES = {
    "allow": {"command": "git status", "expect": "ALLOW"},
    "deny": {"command": "bao kv destroy secret/app/db", "expect": "DENIED by icg"},
}


def eprint(*args):
    print(*args, file=sys.stderr)


def resolve_binary(requested):
    """Find the icg binary to time, preferring a release build."""
    candidates = []
    if requested:
        candidates.append(("requested", Path(requested)))
    elif os.environ.get("ICG_BENCH_BIN"):
        candidates.append(("ICG_BENCH_BIN", Path(os.environ["ICG_BENCH_BIN"])))
    else:
        try:
            metadata = subprocess.run(
                ["cargo", "metadata", "--format-version", "1", "--no-deps"],
                capture_output=True,
                text=True,
                check=True,
            )
            target_dir = json.loads(metadata.stdout)["target_directory"]
            candidates.append(("cargo release build", Path(target_dir) / "release" / "icg"))
        except (OSError, subprocess.CalledProcessError, KeyError, ValueError):
            pass
        candidates.append(("PATH", None))

    for source, path in candidates:
        if path is None:
            found = __import__("shutil").which("icg")
            if found:
                return found, source
            continue
        if path.is_file() and os.access(path, os.X_OK):
            return str(path), source
    eprint("error: no icg binary found; pass --binary <path> or build one first:")
    eprint("  cargo build --release")
    sys.exit(2)


def discover_packs(binary, cwd, pack_args):
    """Ask the binary itself which packs a check loads, via check --debug."""
    try:
        run = subprocess.run(
            [binary, "check", "--debug", "--command", "git status", *pack_args],
            capture_output=True,
            text=True,
            cwd=cwd,
            check=True,
        )
    except subprocess.CalledProcessError as error:
        return {"count": None, "paths": [], "error": str(error)}
    count = None
    paths = []
    for line in run.stderr.splitlines():
        if line.startswith("Loaded ") and line.endswith(" rule pack(s)"):
            count = int(line.removeprefix("Loaded ").removesuffix(" rule pack(s)"))
        elif line.startswith("  /") or line.startswith("  ."):
            paths.append(line.strip())
    return {"count": count, "paths": paths, "error": None}


def read_first_line(path, prefix):
    try:
        with open(path) as handle:
            for line in handle:
                if line.startswith(prefix):
                    # /proc/cpuinfo separates the field from its value with a
                    # tab before the colon; collapse it for readable output.
                    return line.replace("\t", " ").strip()
    except OSError:
        pass
    return None


def environment_record(binary, binary_source, cwd, pack_args):
    """Everything a latency number needs to be interpretable later."""
    record = {
        "timestamp_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "hostname": platform.node(),
        "kernel": platform.release(),
        "cpu_model": read_first_line("/proc/cpuinfo", "model name"),
        # Affinity-aware: a worker pinned to a subset of cores must not
        # report the host's full core count as its measurement environment.
        "cpu_count": len(os.sched_getaffinity(0))
        if hasattr(os, "sched_getaffinity")
        else os.cpu_count(),
        "memtotal": read_first_line("/proc/meminfo", "MemTotal"),
        "loadavg": read_first_line("/proc/loadavg", ""),
        "binary": binary,
        "binary_source": binary_source,
        "version": binary_version(binary),
        "profile": "release" if os.path.sep + "release" + os.path.sep in binary else "unknown",
        "cwd": str(cwd),
        "packs": discover_packs(binary, cwd, pack_args),
    }
    return record


def binary_version(binary):
    try:
        run = subprocess.run(
            [binary, "--version"], capture_output=True, text=True, check=True
        )
        return run.stdout.strip()
    except (OSError, subprocess.CalledProcessError) as error:
        return f"unavailable ({error})"


def sample_case(binary, cwd, pack_args, case_name, warmup, iterations, denial_log):
    """Time `iterations` whole-process checks; verify every verdict."""
    case = CASES[case_name]
    argv = [binary, "check", "--command", case["command"], *pack_args]
    env = dict(os.environ)
    env["ICG_DENIAL_LOG"] = denial_log

    for _ in range(warmup):
        verify_run(subprocess.run(argv, capture_output=True, text=True, cwd=cwd, env=env),
                   case, case_name)

    samples_ms = []
    for _ in range(iterations):
        start = time.perf_counter_ns()
        run = subprocess.run(argv, capture_output=True, text=True, cwd=cwd, env=env)
        elapsed_ms = (time.perf_counter_ns() - start) / 1e6
        verify_run(run, case, case_name)
        samples_ms.append(elapsed_ms)

    ordered = sorted(samples_ms)

    def percentile(fraction):
        index = max(0, min(len(ordered) - 1, round(fraction * len(ordered)) - 1))
        return ordered[index]

    return {
        "command": case["command"],
        "expect": case["expect"],
        "warmup": warmup,
        "iterations": iterations,
        "min_ms": ordered[0],
        "p50_ms": statistics.median(ordered),
        "mean_ms": statistics.fmean(ordered),
        "p90_ms": percentile(0.90),
        "p99_ms": percentile(0.99),
        "max_ms": ordered[-1],
        "stdev_ms": statistics.stdev(ordered) if len(ordered) > 1 else 0.0,
    }


def verify_run(run, case, case_name):
    if run.returncode != 0:
        eprint(f"error: {case_name} case exited {run.returncode}: {run.stderr.strip()}")
        sys.exit(3)
    if not run.stdout.startswith(case["expect"]):
        eprint(
            f"error: {case_name} case printed '{run.stdout.strip()[:60]}' but "
            f"expected '{case['expect']}' — not benchmarking a mis-evaluating binary"
        )
        sys.exit(3)


def main():
    parser = argparse.ArgumentParser(
        description="Warm-cache latency benchmark for `icg check` "
        "(method docs: docs/notes/check-latency-benchmark.md)"
    )
    parser.add_argument("--binary", help="icg binary to time (default: cargo release build, then PATH)")
    parser.add_argument(
        "--cases",
        default="allow,deny",
        help="comma-separated subset of: allow, deny (default: both)",
    )
    parser.add_argument("--warmup", type=int, default=10, help="untimed warm-cache runs per case")
    parser.add_argument("--iterations", type=int, default=100, help="timed samples per case")
    parser.add_argument(
        "--cwd",
        default=str(REPO_ROOT),
        help="working directory for the checks (default: this repository; "
        "pack resolution is the binary's own — cwd packs/ plus /etc/icg/packs)",
    )
    parser.add_argument(
        "--pack",
        action="append",
        default=None,
        metavar="PATH",
        help="pass --pack through to icg (replaces its default pack resolution)",
    )
    parser.add_argument("--json", action="store_true", help="emit the full report as JSON")
    parser.add_argument(
        "--assert-under",
        type=float,
        metavar="MS",
        default=None,
        help="regression gate: exit 1 if any selected case's p50 is at or above MS",
    )
    args = parser.parse_args()

    selected = [name.strip() for name in args.cases.split(",") if name.strip()]
    unknown = [name for name in selected if name not in CASES]
    if unknown:
        eprint(f"error: unknown case(s) {unknown}; known: {sorted(CASES)}")
        sys.exit(2)
    if args.iterations < 1 or args.warmup < 0:
        eprint("error: --iterations must be >= 1 and --warmup >= 0")
        sys.exit(2)

    binary, binary_source = resolve_binary(args.binary)
    cwd = str(Path(args.cwd).resolve())
    pack_args = [item for path in args.pack or [] for item in ("--pack", path)]

    # Benchmark denials append to a scratch log, never the operator's.
    denial_fd, denial_log = tempfile.mkstemp(prefix="icg-bench-denials-", suffix=".jsonl")
    os.close(denial_fd)
    try:
        env_record = environment_record(binary, binary_source, cwd, pack_args)
        results = {
            name: sample_case(
                binary, cwd, pack_args, name, args.warmup, args.iterations, denial_log
            )
            for name in selected
        }
    finally:
        try:
            os.unlink(denial_log)
        except OSError:
            pass

    report = {
        "method": {
            "sample": "one whole icg check process, wall clock (perf_counter_ns)",
            "warm_cache": "page cache only, via per-case warmup runs; the engine keeps no cross-process cache",
            "denial_log": "temporary ICG_DENIAL_LOG per run, deleted afterwards",
            "network": "none: neither default case is a push",
        },
        "environment": env_record,
        "results": results,
    }

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(
            f"icg check warm-cache latency — {env_record['version']} "
            f"({env_record['profile']} build, source: {binary_source})"
        )
        print(f"host: {env_record['hostname']} | {env_record['cpu_model']} "
              f"| {env_record['cpu_count']} cores | load {env_record['loadavg']}")
        packs = env_record["packs"]
        print(f"packs loaded: {packs['count']} (cwd {cwd})")
        for name, stats in results.items():
            print(
                f"{name:>5} ({stats['iterations']} runs, {stats['warmup']} warmup): "
                f"min {stats['min_ms']:.2f} | p50 {stats['p50_ms']:.2f} | mean {stats['mean_ms']:.2f} "
                f"| p90 {stats['p90_ms']:.2f} | p99 {stats['p99_ms']:.2f} | max {stats['max_ms']:.2f} ms"
            )

    if args.assert_under is not None:
        offenders = [
            (name, stats["p50_ms"])
            for name, stats in results.items()
            if stats["p50_ms"] >= args.assert_under
        ]
        if offenders:
            detail = ", ".join(f"{name} p50={ms:.2f}ms" for name, ms in offenders)
            eprint(
                f"FAIL: warm-cache p50 at or above {args.assert_under} ms: {detail} "
                "(see docs/notes/check-latency-benchmark.md for the baseline record)"
            )
            sys.exit(1)
        if not args.json:
            print(f"OK: all case p50s under {args.assert_under} ms")


if __name__ == "__main__":
    main()
