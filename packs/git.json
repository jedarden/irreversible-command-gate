{
  "id": "git",
  "tool_keywords": ["git"],
  "applies_to": [],
  "safe_patterns": [
    {
      "id": "safe-git-status",
      "type": "command_regex",
      "regex": "^git status"
    },
    {
      "id": "safe-git-fetch",
      "type": "command_regex",
      "regex": "^git fetch"
    },
    {
      "id": "safe-git-pull",
      "type": "command_regex",
      "regex": "^git pull"
    },
    {
      "id": "safe-git-log",
      "type": "command_regex",
      "regex": "^git (log|show|diff)"
    },
    {
      "id": "safe-git-branch",
      "type": "command_regex",
      "regex": "^git branch"
    }
  ],
  "guarded_patterns": [
    {
      "id": "git-force-push",
      "type": "command_regex",
      "regex": "^git\\s+push(?:\\s+\\S+)*\\s+(?:--force-with-lease(?:=\\S+)?|--force|-f)(?:\\s|$)",
      "tier": "tier1",
      "severity": "Critical",
      "explanation": "Force-push flags can rewrite git history and lose commits",
      "destructive": true,
      "redirect": {
        "channel": "updated_input",
        "reason_template": "Removed --force/-f/--force-with-lease from git push; force-pushing can rewrite remote history and lose commits. Retrying as a normal push preserves the requested commits without rewriting the remote.",
        "rewrite_template": "{command_without_force}"
      }
    },
    {
      "id": "git-commit-without-pathspec",
      "type": "command_regex",
      "regex": "^(?:git\\s+commit(?:\\s+(?:'[^']*'|\"[^\"]*\"|[^\\s'\"]+))*\\s+(?:-a[a-zA-Z]*|--all(?:=[^\\s]*)?)(?:\\s|$)|git\\s+commit(?:\\s+(?:--?[A-Za-z0-9][A-Za-z0-9-]*(?:=[^\\s]*)?|-[A-Za-z0-9]+))*\\s+(?:-m(?:=|\\s+)|--message(?:=|\\s+))(?:'[^']*'|\"[^\"]*\"|[^\\s'\"]+)(?:\\s+(?:--?[A-Za-z0-9][A-Za-z0-9-]*(?:=[^\\s]*)?|-[A-Za-z0-9]+))*$)",
      "tier": "tier1",
      "severity": "High",
      "explanation": "A git commit without an explicit pathspec commits the entire staged index, which may include unrelated pre-staged changes",
      "destructive": true,
      "redirect": {
        "channel": "deny",
        "reason_template": "git commit without a pathspec can sweep unrelated staged changes into the commit. Pass the same file paths to git commit that you passed to git add -- git commit <paths> -m \"...\".",
        "rewrite_template": null
      }
    }
  ]
}
