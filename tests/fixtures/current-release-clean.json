{
  "id": "test-pack-current-clean",
  "safe_patterns": [
    {
      "id": "safe-read-operations",
      "check": "vault kv get"
    },
    {
      "id": "safe-list",
      "check": "vault.*list"
    },
    {
      "id": "safe-git-status",
      "check": "^git status"
    },
    {
      "id": "safe-git-log",
      "check": "git log"
    }
  ],
  "guarded_patterns": [
    {
      "id": "vault-kv-destroy",
      "check": "vault kv destroy",
      "tier": 1,
      "severity": "Critical",
      "explanation": "Permanently destroys vault data versions",
      "destructive": true
    },
    {
      "id": "vault-policy-delete",
      "check": "vault policy delete",
      "tier": 1,
      "severity": "High",
      "explanation": "Deletes an ACL policy",
      "destructive": true
    },
    {
      "id": "git-force-push",
      "check": "git push.*--force",
      "tier": 1,
      "severity": "Critical",
      "explanation": "Force-push rewrites git history",
      "destructive": true
    },
    {
      "id": "vault-secrets-disable",
      "check": "vault secrets disable",
      "tier": 1,
      "severity": "High",
      "explanation": "Disables an entire secrets engine",
      "destructive": true
    },
    {
      "id": "docker-rmi-force",
      "check": "docker rmi.*--force",
      "tier": 1,
      "severity": "Medium",
      "explanation": "Force removal of docker images",
      "destructive": false
    }
  ]
}
