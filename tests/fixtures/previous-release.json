{
  "id": "test-pack-previous",
  "tool_keywords": ["vault", "git"],
  "applies_to": ["*.yaml", "*.yml"],
  "safe_patterns": [
    {
      "id": "safe-vault-read",
      "type": "command_regex",
      "regex": "vault kv get"
    },
    {
      "id": "safe-vault-list",
      "type": "command_regex",
      "regex": "vault.*list"
    },
    {
      "id": "safe-git-status",
      "type": "command_regex",
      "regex": "^git status"
    },
    {
      "id": "safe-storage-class",
      "type": "content_regex",
      "regex": "storageClassName: (sata|sata-large|standard)"
    },
    {
      "id": "safe-image-tag",
      "type": "content_regex",
      "regex": "image: [a-z0-9/-]+:v[0-9]+\\.[0-9]+\\.[0-9]+"
    }
  ],
  "guarded_patterns": [
    {
      "id": "vault-kv-destroy",
      "type": "command_regex",
      "regex": "vault kv destroy",
      "tier": "tier1",
      "severity": "Critical",
      "explanation": "Permanently destroys vault data versions",
      "destructive": true,
      "redirect": {
        "channel": "deny",
        "reason_template": "vault kv destroy is permanently destructive and cannot be undone",
        "rewrite_template": null
      }
    },
    {
      "id": "vault-policy-delete",
      "type": "command_regex",
      "regex": "vault policy delete",
      "tier": "tier1",
      "severity": "High",
      "explanation": "Deletes an ACL policy",
      "destructive": true,
      "redirect": {
        "channel": "deny",
        "reason_template": "Deleting ACL policies can remove access controls",
        "rewrite_template": null
      }
    },
    {
      "id": "vault-secrets-disable",
      "type": "command_regex",
      "regex": "vault secrets disable",
      "tier": "tier1",
      "severity": "High",
      "explanation": "Disables an entire secrets engine",
      "destructive": true,
      "redirect": {
        "channel": "deny",
        "reason_template": "Disabling a secrets engine cuts off access to all secrets under it",
        "rewrite_template": null
      }
    },
    {
      "id": "git-force-push",
      "type": "command_regex",
      "regex": "git push.*--force",
      "tier": "tier1",
      "severity": "Critical",
      "explanation": "Force-push rewrites git history",
      "destructive": true,
      "redirect": {
        "channel": "deny",
        "reason_template": "Force-push rewrites git history and can lose commits. Use git push --force-with-lease instead.",
        "rewrite_template": "git push --force-with-lease"
      }
    },
    {
      "id": "storage-class-ssd",
      "type": "content_regex",
      "regex": "storageClassName:.*ssd",
      "tier": "tier1",
      "severity": "High",
      "explanation": "SSD storage class is prohibited on Rackspace Spot",
      "destructive": true,
      "redirect": {
        "channel": "deny",
        "reason_template": "SSD and SSD-Large storage classes are prohibited on Rackspace Spot. Use sata or sata-large instead, and always set storageClassName explicitly.",
        "rewrite_template": "storageClassName: sata"
      }
    },
    {
      "id": "image-tag-latest",
      "type": "content_regex",
      "regex": "image: .*:latest",
      "tier": "tier1",
      "severity": "High",
      "explanation": "Using :latest image tag prevents reproducible deployments",
      "destructive": true,
      "redirect": {
        "channel": "deny",
        "reason_template": "Never use :latest or bare git SHA for ronaldraygun/* images. Pin a semver tag from containers/<name>/VERSION.",
        "rewrite_template": null
      }
    },
    {
      "id": "image-tag-bare-sha",
      "type": "content_regex",
      "regex": "image: ronaldraygun/[a-z-]+:[0-9a-f]{8,64}",
      "tier": "tier1",
      "severity": "High",
      "explanation": "Bare git SHA image tag prevents reproducible deployments",
      "destructive": true,
      "redirect": {
        "channel": "deny",
        "reason_template": "Never use :latest or bare git SHA for ronaldraygun/* images. Pin a semver tag from containers/<name>/VERSION.",
        "rewrite_template": null
      }
    },
    {
      "id": "vault-token-revoke",
      "type": "command_regex",
      "regex": "vault token revert",
      "tier": "tier1",
      "severity": "Medium",
      "explanation": "Revokes vault tokens",
      "destructive": true,
      "redirect": {
        "channel": "deny",
        "reason_template": "Revoking tokens can terminate active sessions",
        "rewrite_template": null
      }
    }
  ]
}
