[Unit]
Description=Unified Bead Starvation Auto-Repair Timer
Documentation=https://github.com/jedarden/irreversible-command-gate
Requires=bead-starvation-unified-repair.service

[Timer]
# Run every 5 minutes
OnCalendar=*:0/5
# Also run on boot if the last run was missed
Persistent=true
# Randomize start time by up to 30 seconds to avoid drift
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
