/target

# NEEDLE execution traces and dispatch state are local diagnostics.
**/.beads/traces/
.needle-predispatch-sha

# Bead tooling elsewhere on the host writes these into this workspace.
.beads/diagnostics/
.beads/events.jsonl
.beads/*.pid

# Local NEEDLE and bead runtime state
.needle-predispatch-sha
.beads/events.jsonl
.beads/heartbeats.jsonl
.beads/diagnostics/
.beads/logs/
.beads/traces/
.beads/receipts/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
.beads/*.db.backup.*
.beads/*.lock
.beads/*.tmp
.beads/*.temp
.beads/*.journal
.br_recovery/
